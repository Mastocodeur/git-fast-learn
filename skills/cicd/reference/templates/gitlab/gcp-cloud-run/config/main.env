# production (main branch). Per-env GCP target — NON-SECRET, versioned.
# File name MUST match the branch name (loaded as config/$CI_COMMIT_BRANCH.env). Use master.env if your prod branch is master.
# Secrets live in Secret Manager (injected at deploy).
GCP_PROJECT=<project-id-prod>
REGION=europe-west1
AR_REPO=<artifact-registry-repo>
CLOUD_RUN_SERVICE=<service-name>
