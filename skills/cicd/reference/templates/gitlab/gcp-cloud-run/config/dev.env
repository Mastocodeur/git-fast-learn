# Per-env GCP target — NON-SECRET, versioned. One file per environment branch.
# File name MUST match the branch name (loaded as config/$CI_COMMIT_BRANCH.env).
# Secrets are NOT here: they live in Secret Manager and are injected at deploy (--set-secrets).
GCP_PROJECT=<project-id-dev>
REGION=europe-west1
AR_REPO=<artifact-registry-repo>
CLOUD_RUN_SERVICE=<service-name>
